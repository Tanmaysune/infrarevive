; Template only — the real inventory.ini is generated by setup-config.sh
; from `terraform output` and is intentionally not committed (it holds
; live public IPs that change on every stop/start).
;
; Copy this file to inventory.ini only if you want to run Ansible by hand
; against a cluster you provisioned some other way.

[jenkins]
JENKINS_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/infrarevive-key.pem

[k8s_master]
MASTER_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/infrarevive-key.pem

[k8s_workers]
WORKER0_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/infrarevive-key.pem
WORKER1_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/infrarevive-key.pem
WORKER2_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/infrarevive-key.pem
