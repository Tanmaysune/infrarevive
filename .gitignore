# ---------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.ppk
id_rsa*
kubeconfig
.kube/

# ---------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
override.tf
override.tf.json
*_override.tf
.terraformrc
terraform.rc

# ---------------------------------------------------------------
# Generated at runtime by setup-config.sh / start-all.sh
# (real IPs get written into these — never commit them)
# ---------------------------------------------------------------
ansible/inventory.ini
prometheus/prometheus.yml
dashboard_live.html

# ---------------------------------------------------------------
# Vendored / downloaded tooling — install from upstream instead
# ---------------------------------------------------------------
aws/
awscliv2.zip
*.zip
*.tar.gz

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

